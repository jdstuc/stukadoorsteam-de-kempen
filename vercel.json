{
  "version": 2,
  "buildCommand": "npm run build:production",
  "installCommand": "npm install && npm run build:production",
  "builds": [
    {
      "src": "server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "server.ts"
    }
  ]
}
